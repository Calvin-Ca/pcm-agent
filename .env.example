# ============================================================
# AI 智能助手 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值，.env 文件不要提交到 Git
# ============================================================

# ── LLM 配置（意图分类，建议轻量快速模型）───────────────────
INTENT_LLM_API_KEY=your_api_key_here
INTENT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
INTENT_LLM_MODEL=qwen-turbo

# ── LLM 配置（对话生成，建议能力更强的模型）─────────────────
CHAT_LLM_API_KEY=your_api_key_here
CHAT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_LLM_MODEL=qwen-plus

# ── MySQL 数据库 ─────────────────────────────────────────────
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=workhour
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # 生产环境建议设置密码

# ── Milvus 向量数据库 ─────────────────────────────────────────
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ── SQL Agent 数据库配置（空 = 复用上方 MYSQL_* 配置）─────────
# SQL_AGENT_DB_HOST=
# SQL_AGENT_DB_PORT=3306
# SQL_AGENT_DB_NAME=
# SQL_AGENT_DB_USER=
# SQL_AGENT_DB_PASSWORD=

# ── SQL Agent LLM 配置（空 = 复用上方 CHAT_LLM 配置）──────────
# SQL_AGENT_LLM_API_KEY=
# SQL_AGENT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# SQL_AGENT_LLM_MODEL=qwen-plus

# ── SQL Agent 安全配置 ─────────────────────────────────────────
# SQL_AGENT_ENABLED=true
# SQL_AGENT_MAX_ROWS=500
# SQL_AGENT_QUERY_TIMEOUT=30

# ── SpringBoot 后端地址 ───────────────────────────────────────
SPRINGBOOT_BASE_URL=https://gst.thsware.com
# 本地开发时切换为：
# SPRINGBOOT_BASE_URL=http://host.docker.internal:8080

# ── MinIO（Milvus 依赖）──────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here

# ── 应用配置 ─────────────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
