# ============================================================
# AI 智能助手 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值，.env 文件不要提交到 Git
# ============================================================

# ── LLM 配置（意图分类）──────────────────────────────────────
# 生产/开发：使用内网 vLLM（172.19.3.136:8099）
INTENT_LLM_API_KEY=EMPTY
INTENT_LLM_API_BASE=http://172.19.3.136:8099/v1
INTENT_LLM_MODEL=qwen3-8b
# 备用（无内网访问时切换为阿里云 DashScope）：
# INTENT_LLM_API_KEY=sk-your_dashscope_key
# INTENT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# INTENT_LLM_MODEL=qwen-turbo

# ── LLM 配置（主对话生成）────────────────────────────────────
CHAT_LLM_API_KEY=EMPTY
CHAT_LLM_API_BASE=http://172.19.3.136:8099/v1
CHAT_LLM_MODEL=qwen3-8b
# 备用（无内网访问时切换为阿里云 DashScope）：
# CHAT_LLM_API_KEY=sk-your_dashscope_key
# CHAT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# CHAT_LLM_MODEL=qwen-plus

# ── MySQL 数据库（Spring Boot 业务账号）──────────────────────
MYSQL_HOST=192.168.0.94
MYSQL_PORT=3306
MYSQL_DATABASE=workhour
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# ── SQL Agent 只读账号（专用，禁止使用 root 或业务账号）──────
SQL_AGENT_DB_HOST=192.168.0.94
SQL_AGENT_DB_PORT=3306
SQL_AGENT_DB_NAME=workhour
SQL_AGENT_DB_USER=read_only_ai
SQL_AGENT_DB_PASSWORD=your_readonly_password

# ── SQL Agent LLM（空 = 复用上方 CHAT_LLM 配置）─────────────
# SQL_AGENT_LLM_API_KEY=
# SQL_AGENT_LLM_API_BASE=
# SQL_AGENT_LLM_MODEL=

# ── SQL Agent 安全配置 ────────────────────────────────────────
# SQL_AGENT_ENABLED=true
# SQL_AGENT_MAX_ROWS=500
# SQL_AGENT_QUERY_TIMEOUT=30

# ── Redis ─────────────────────────────────────────────────────
# Docker 部署时保持 redis（容器名），裸跑时改为 127.0.0.1
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # 生产环境建议设置密码

# ── Milvus 向量数据库 ─────────────────────────────────────────
# Docker 部署时保持 milvus（容器名），裸跑时改为 127.0.0.1
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ── SpringBoot 后端地址 ───────────────────────────────────────
# Docker 部署时使用 host.docker.internal 访问宿主机 Spring Boot
# 裸跑时使用 127.0.0.1
SPRINGBOOT_BASE_URL=http://host.docker.internal:9900

# ── MinIO（Milvus 依赖）──────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here

# ── 应用配置 ──────────────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
