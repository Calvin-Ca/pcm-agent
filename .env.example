# ============================================================
# 模型分层（方案 A）：按能力分 3 层，复杂场景切 API、轻量留本地 8b
#   轻量层  INTENT_LLM_* / CHAT_LLM_*   → 本地 vLLM 8b（意图降级 / 闲聊 / 单工具 FC）
#   推理层  PLANNER_LLM_*               → 托管 API（多步规划 / batch / A-RAG 多步）
#   SQL 层  SQL_AGENT_LLM_*             → 托管 API（SQL 生成）
# 留空的层自动回退 CHAT_LLM，先合代码后填值是安全的。
# ============================================================

# ============================================================
# AI 智能助手 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值，.env 文件不要提交到 Git
# ============================================================

# ── LLM 配置（意图分类）──────────────────────────────────────
# 生产/开发：使用内网 vLLM（172.19.3.136:8099）
INTENT_LLM_API_KEY=EMPTY
INTENT_LLM_API_BASE=http://172.19.3.136:8099/v1
INTENT_LLM_MODEL=qwen3-8b
# 备用（无内网访问时切换为阿里云 DashScope）：
# INTENT_LLM_API_KEY=sk-your_dashscope_key
# INTENT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# INTENT_LLM_MODEL=qwen-turbo

# ── LLM 配置（主对话生成）────────────────────────────────────
CHAT_LLM_API_KEY=EMPTY
CHAT_LLM_API_BASE=http://172.19.3.136:8099/v1
CHAT_LLM_MODEL=qwen3-8b
# 备用（无内网访问时切换为阿里云 DashScope）：
# CHAT_LLM_API_KEY=sk-your_dashscope_key
# CHAT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# CHAT_LLM_MODEL=qwen-plus

# 进程级 LLM 并发上限（所有 LLMClient 共享同一信号量，覆盖整个重试周期）
# 默认 16（不配亦安全，正常负载行为不变）；<=0 表示不限流
# LLM_MAX_CONCURRENCY=16

# ── LLM 配置（推理层 / 复杂场景）─────────────────────────────
# 多步规划(PlannerAgent) + 批量工时解析 + A-RAG 知识库多步导航
# 留空 = 回退 CHAT_LLM（本地 8b）；填值 = 复杂场景走托管 API
# PLANNER_LLM_API_KEY=sk-your_dashscope_key
# PLANNER_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# PLANNER_LLM_MODEL=qwen-plus

# ── MySQL 数据库（Spring Boot 业务账号）──────────────────────
MYSQL_HOST=192.168.0.94
MYSQL_PORT=3306
MYSQL_DATABASE=workhour
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# ── SQL Agent 只读账号（专用，禁止使用 root 或业务账号）──────
SQL_AGENT_DB_HOST=192.168.0.94
SQL_AGENT_DB_PORT=3306
SQL_AGENT_DB_NAME=workhour
SQL_AGENT_DB_USER=read_only_ai
SQL_AGENT_DB_PASSWORD=your_readonly_password

# ── SQL Agent LLM（空 = 复用 CHAT_LLM；建议指向托管 API）────
# SQL_AGENT_LLM_API_KEY=sk-your_dashscope_key
# SQL_AGENT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# SQL_AGENT_LLM_MODEL=qwen-plus

# ── SQL Agent 安全配置 ────────────────────────────────────────
# SQL_AGENT_ENABLED=true
# SQL_AGENT_MAX_ROWS=500
# SQL_AGENT_QUERY_TIMEOUT=30

# ── Redis ─────────────────────────────────────────────────────
# Docker 部署时保持 redis（容器名），裸跑时改为 127.0.0.1
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # 生产环境建议设置密码

# ── Milvus 向量数据库 ─────────────────────────────────────────
# Docker 部署时保持 milvus（容器名），裸跑时改为 127.0.0.1
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ── SpringBoot 后端地址 ───────────────────────────────────────
# Docker 部署时使用 host.docker.internal 访问宿主机 Spring Boot
# 裸跑时使用 127.0.0.1
SPRINGBOOT_BASE_URL=http://host.docker.internal:9900

# ── 会话审计日志 ─────────────────────────────────────────────
# true（默认，生产）= 每轮对话写入 MySQL conversation_logs 表（微调数据集来源）
# false = 跳过。本地开发建议关闭：内网 MySQL 不可达会每请求白等数秒 TCP 超时，
#         且本地测试流量不该混进微调数据集
CONVERSATION_LOG_ENABLED=true

# ── 写操作安全阀 ─────────────────────────────────────────────
# true = 强制所有写工具（save_workhour / batch_save_workhour）只做 dry_run 预览，
#        不实际入库。本地开发接生产隧道时务必打开。
# false（默认，生产）= 各写工具沿用自身默认：单条直写、批量先预览。
# 单向阀：只会让行为更安全，不会削弱已有保护。实现见 app/tools/_write_guard.py
WRITE_DRY_RUN_DEFAULT=false

# ── MinIO（Milvus 依赖）──────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here

# ── 应用配置 ──────────────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── Langfuse 可观测性（可选；LANGFUSE_TRACING=false 时完全旁路）──────────
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_BASE_URL=http://172.19.3.136:3030
