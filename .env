# AI智能助手环境变量配置
# 按功能模块分别配置LLM，各模块可独立选模型、独立计费

# ========== 意图识别 LLM（轻量模型，速度优先） ==========
INTENT_LLM_API_KEY=sk-f9e8301e97fb460e85212722ac570f3d
INTENT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
INTENT_LLM_MODEL=qwen-flash

# ========== 主对话 LLM（能力更强的模型） ==========
CHAT_LLM_API_KEY=sk-73e6c97a1fec4192af6258102603da5f
CHAT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_LLM_MODEL=qwen-plus

# ========== 任务规划 LLM（可选，默认复用主对话配置） ==========
