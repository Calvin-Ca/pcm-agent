# PLANNER_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# PLANNER_LLM_MODEL=qwen-max

# 可选：使用本地LLM
# CHAT_LLM_API_BASE=http://localhost:11434/v1
# CHAT_LLM_MODEL=llama2

