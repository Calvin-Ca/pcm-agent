{"asctime": "2026-03-23 08:47:57", "name": "sqlalchemy.engine.Engine", "levelname": "INFO", "message": "\nCREATE TABLE conversation_logs (\n\tid INTEGER NOT NULL COMMENT '\u4e3b\u952eID' AUTO_INCREMENT, \n\tsession_id VARCHAR(64) NOT NULL COMMENT '\u4f1a\u8bddID', \n\tuser_id VARCHAR(64) NOT NULL COMMENT '\u7528\u6237ID', \n\tuser_message TEXT NOT NULL COMMENT '\u7528\u6237\u6d88\u606f', \n\trequest_time DATETIME NOT NULL COMMENT '\u8bf7\u6c42\u65f6\u95f4', \n\troute_type VARCHAR(32) NOT NULL COMMENT '\u8def\u7531\u7c7b\u578b: LLM_SERVICE/TOOL_CALL/TASK_PLANNING', \n\tintent VARCHAR(64) COMMENT '\u8bc6\u522b\u7684\u610f\u56fe', \n\thistory_turns_count INTEGER COMMENT '\u6ce8\u5165\u7684\u5386\u53f2\u5bf9\u8bdd\u8f6e\u6b21\u6570', \n\tmemory_count INTEGER COMMENT '\u6ce8\u5165\u7684\u957f\u671f\u8bb0\u5fc6\u6761\u6570', \n\tcontext_snapshot JSON COMMENT '\u4e0a\u4e0b\u6587\u5feb\u7167\uff1a\u6700\u8fd12\u8f6e\u5386\u53f2+\u4f7f\u7528\u7684\u8bb0\u5fc6', \n\ttools_called JSON COMMENT '\u8c03\u7528\u7684\u5de5\u5177\u5217\u8868 [{name, params, result}]', \n\ttool_count INTEGER COMMENT '\u5de5\u5177\u8c03\u7528\u6b21\u6570', \n\thas_task_plan BOOL COMMENT '\u662f\u5426\u8fdb\u884c\u4e86\u4efb\u52a1\u89c4\u5212', \n\ttask_plan JSON COMMENT '\u4efb\u52a1\u89c4\u5212\u8be6\u60c5', \n\tai_response TEXT COMMENT 'AI\u54cd\u5e94\u5185\u5bb9', \n\tresponse_time DATETIME COMMENT '\u54cd\u5e94\u65f6\u95f4', \n\tduration_ms INTEGER COMMENT '\u5904\u7406\u8017\u65f6(\u6beb\u79d2)', \n\tprompt_tokens INTEGER COMMENT '\u8f93\u5165token\u6570', \n\tcompletion_tokens INTEGER COMMENT '\u8f93\u51fatoken\u6570', \n\ttotal_tokens INTEGER COMMENT '\u603btoken\u6570', \n\tmodel_name VARCHAR(64) COMMENT '\u4f7f\u7528\u7684LLM\u6a21\u578b\u540d\u79f0', \n\tstatus VARCHAR(16) NOT NULL COMMENT '\u72b6\u6001: success/error', \n\terror_message TEXT COMMENT '\u9519\u8bef\u4fe1\u606f', \n\textra_data JSON COMMENT '\u5176\u4ed6\u5143\u6570\u636e', \n\tcreated_at DATETIME NOT NULL COMMENT '\u521b\u5efa\u65f6\u95f4', \n\tPRIMARY KEY (id)\n)\n\n"}
