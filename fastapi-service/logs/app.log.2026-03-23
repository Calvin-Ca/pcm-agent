{"asctime": "2026-03-23 08:47:57", "name": "sqlalchemy.engine.Engine", "levelname": "INFO", "message": "\nCREATE TABLE ai_sessions (\n\tsession_id VARCHAR(64) NOT NULL COMMENT '\u4f1a\u8bddID', \n\tuser_id VARCHAR(64) NOT NULL COMMENT '\u7528\u6237ID', \n\tturn_count INTEGER NOT NULL COMMENT '\u5bf9\u8bdd\u8f6e\u6b21\u6570', \n\ttotal_tokens INTEGER NOT NULL COMMENT '\u7d2f\u8ba1token\u6d88\u8017', \n\tcreated_at DATETIME NOT NULL COMMENT '\u4f1a\u8bdd\u521b\u5efa\u65f6\u95f4', \n\tlast_active DATETIME NOT NULL COMMENT '\u6700\u540e\u6d3b\u8dc3\u65f6\u95f4', \n\tPRIMARY KEY (session_id)\n)\n\n"}
